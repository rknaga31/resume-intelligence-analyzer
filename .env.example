# =============================================================================
# Environment Variables — Example Template
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file — it is listed in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                          # development | staging | production
APP_SECRET_KEY=your-secret-key-here          # 32+ random bytes; use: openssl rand -hex 32
DEBUG=true
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# API Server (FastAPI)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1                                # Increase in production (2 × CPU cores + 1)
ALLOWED_ORIGINS=http://localhost:3000        # CORS: comma-separated frontend URLs

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resume_intelligence
POSTGRES_USER=ria_user
POSTGRES_PASSWORD=your-postgres-password-here
DATABASE_URL=postgresql+asyncpg://ria_user:your-postgres-password-here@localhost:5432/resume_intelligence

# ---------------------------------------------------------------------------
# Redis (caching / task queue)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# AI / LLM Providers  ← Keep these secret!
# ---------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (optional alternative)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (optional alternative)
GOOGLE_API_KEY=AIza...
GOOGLE_GEMINI_MODEL=gemini-1.5-pro

# HuggingFace (for local / self-hosted models)
HUGGINGFACE_API_TOKEN=hf_...
HUGGINGFACE_CACHE_DIR=./models

# ---------------------------------------------------------------------------
# Vector Database (for semantic search & embeddings)
# ---------------------------------------------------------------------------
# Pinecone (cloud option)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=resume-vectors

# Weaviate (self-hosted option)
WEAVIATE_URL=http://localhost:8080

# Qdrant (self-hosted option)
QDRANT_URL=http://localhost:6333

# ---------------------------------------------------------------------------
# File Storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_RESUME_TYPES=pdf,docx,doc,txt

# AWS S3 (optional, for production file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=your-jwt-secret-key-here      # Use: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Email (for notifications — optional)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=no-reply@resume-intelligence.example.com

# ---------------------------------------------------------------------------
# Monitoring & Observability (optional)
# ---------------------------------------------------------------------------
SENTRY_DSN=https://...@sentry.io/...
LANGSMITH_API_KEY=your-langsmith-key         # LangChain tracing
LANGSMITH_PROJECT=resume-intelligence-analyzer
