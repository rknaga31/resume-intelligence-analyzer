# =============================================================================
# Resume Intelligence Analyzer — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# SECRETS & CREDENTIALS  ← NEVER commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
service-account*.json
*_credentials.json
*_secret*.json
google-credentials*.json
aws-credentials
.aws/

# ---------------------------------------------------------------------------
# PYTHON
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.env.d/
env.bak/
venv.bak/
.python-version

# Pytest & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover

# MyPy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Jupyter Notebooks
.ipynb_checkpoints
*.ipynb

# ---------------------------------------------------------------------------
# NODE / REACT / NEXT.JS
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js
.next/
out/

# Nuxt
.nuxt/

# Build output
dist/
build/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
